rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Funções auxiliares
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Moderadores da plataforma (aprovam universidades e moderam conteúdo).
    // IMPORTANTE: esta lista deve ficar sincronizada com ADMIN_EMAILS em
    // src/lib/admin.js. Exige e-mail verificado para que ninguém possa criar
    // uma conta com um desses e-mails sem comprovar a posse da caixa postal.
    function isModerator() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'admin@uniscore.com',
          'moderador@uniscore.com'
        ];
    }

    // Conta de universidade ("administrador da faculdade") já APROVADA por
    // um moderador. Contas com status 'pendente' não têm privilégios.
    function isApprovedUniversity() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/universidades/$(request.auth.uid))
        && get(/databases/$(database)/documents/universidades/$(request.auth.uid)).data.status == 'aprovado';
    }

    // Campos que o próprio usuário nunca pode gravar (gamificação / papéis).
    // Só podem ser alterados via Admin SDK (que ignora estas regras).
    function reservedUserFields() {
      return ['pontos', 'selos', 'estrelas', 'papel', 'role'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ------------------------------------------------------------------
    // Usuários comuns (estudantes) - ambas nomenclaturas
    // ------------------------------------------------------------------
    // O dono lê e escreve o próprio documento, mas não pode gravar os
    // campos reservados (pontos, selos, estrelas, papel, role).
    //
    // Campos validados (RF01), sempre "se presentes":
    //  - nome: string com até 100 caracteres;
    //  - tipoPerfil: 'universitario' | 'familiar' | 'visitante' | 'convidado'
    //    (mantenha sincronizado com TIPOS_PERFIL em src/lib/usuarios.js);
    //  - universidadeId: id de public/universidades.json (string) ou null.
    // Na criação valida todos os campos enviados; na atualização só os campos
    // alterados, para que documentos antigos continuem editáveis.
    // Gravações legítimas: src/lib/usuarios.js (garantirDocumentoUsuario),
    // src/app/cadastro/page.js e src/app/perfil/page.js.
    function isValidTipoPerfil(valor) {
      return valor in ['universitario', 'familiar', 'visitante', 'convidado'];
    }

    function isValidUsuario(data, campos) {
      return (!campos.hasAny(['nome']) || !('nome' in data)
              || (data.nome is string && data.nome.size() <= 100))
        && (!campos.hasAny(['tipoPerfil']) || !('tipoPerfil' in data)
              || isValidTipoPerfil(data.tipoPerfil))
        && (!campos.hasAny(['universidadeId']) || !('universidadeId' in data)
              || data.universidadeId == null
              || (data.universidadeId is string && data.universidadeId.size() <= 50));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(reservedUserFields())
        && isValidUsuario(request.resource.data, request.resource.data.keys());
      allow update: if isOwner(userId)
        && !changedKeys().hasAny(reservedUserFields())
        && isValidUsuario(request.resource.data, changedKeys());
      allow delete: if isOwner(userId);
    }

    match /usuarios/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(reservedUserFields())
        && isValidUsuario(request.resource.data, request.resource.data.keys());
      allow update: if isOwner(userId)
        && !changedKeys().hasAny(reservedUserFields())
        && isValidUsuario(request.resource.data, changedKeys());
      allow delete: if isOwner(userId);
    }

    // ------------------------------------------------------------------
    // Avaliações - leitura pública; criação apenas pelo próprio autor
    // ------------------------------------------------------------------
    // Critério do RF03: null = "Não se aplica"; senão inteiro de 1 a 5.
    function isValidCriterio(valor) {
      return valor == null || (valor is int && valor >= 1 && valor <= 5);
    }

    // Mapa `criterios` gravado por /avaliar: só as 5 chaves conhecidas.
    // Chave ausente é tratada como null.
    function isValidCriterios(c) {
      return c is map
        && c.keys().hasOnly(['acessibilidade', 'conforto', 'interculturalidade', 'politizacao', 'impacto'])
        && isValidCriterio(c.get('acessibilidade', null))
        && isValidCriterio(c.get('conforto', null))
        && isValidCriterio(c.get('interculturalidade', null))
        && isValidCriterio(c.get('politizacao', null))
        && isValidCriterio(c.get('impacto', null));
    }

    // `criterios`, `intercultural` e `titulo` são opcionais para que
    // avaliações antigas (sem esses campos) continuem válidas ao serem editadas.
    function isValidAvaliacao(data) {
      return data.nota is int
        && data.nota >= 1
        && data.nota <= 5
        && (!('comentario' in data) || (data.comentario is string && data.comentario.size() <= 2000))
        && (!('titulo' in data) || (data.titulo is string && data.titulo.size() <= 200))
        && (!('criterios' in data) || isValidCriterios(data.criterios))
        && (!('intercultural' in data) || data.intercultural is map);
    }

    match /avaliacoes/{avaliacaoId} {
      allow read: if true; // Público para leitura

      allow create: if isSignedIn()
        && request.resource.data.usuarioId == request.auth.uid
        && isValidAvaliacao(request.resource.data);

      // Autor pode editar a própria avaliação (sem trocar o autor);
      // moderadores podem editar qualquer uma.
      allow update: if isModerator()
        || (isOwner(resource.data.usuarioId)
            && request.resource.data.usuarioId == resource.data.usuarioId
            && !changedKeys().hasAny(['moderado', 'moderadoPor', 'moderadoEm'])
            && isValidAvaliacao(request.resource.data));

      allow delete: if isModerator() || isOwner(resource.data.usuarioId);
    }

    // ------------------------------------------------------------------
    // Universidades (contas de "administradores das faculdades")
    // ------------------------------------------------------------------
    // Status em uso no código: 'pendente' (gravado no cadastro) e
    // 'aprovado' (definido por um moderador no console / painel).
    match /universidades/{universidadeId} {
      // O dono lê o próprio documento; moderadores leem todos.
      allow read: if isOwner(universidadeId) || isModerator();

      // Cadastro: só para o próprio uid e sempre como 'pendente'.
      // `universidadeId` (campo) = id da entrada em public/universidades.json, ou null.
      allow create: if isOwner(universidadeId)
        && request.resource.data.status == 'pendente'
        && (!('universidadeId' in request.resource.data)
            || request.resource.data.universidadeId == null
            || request.resource.data.universidadeId is string);

      // O dono pode atualizar seus dados, mas não o próprio status nem o
      // vínculo com public/universidades.json; moderadores podem tudo
      // (inclusive aprovar, mudando status para 'aprovado').
      allow update: if isModerator()
        || (isOwner(universidadeId)
            && !changedKeys().hasAny(['status', 'universidadeId']));

      allow delete: if isModerator();
    }

    // ------------------------------------------------------------------
    // Eventos - leitura pública; gerenciados por universidades aprovadas
    // ------------------------------------------------------------------
    // Campo dono: `universidadeUid` = uid (Firebase Auth) da conta de
    // universidade que cadastrou o evento. Todo código que criar eventos
    // DEVE gravar `universidadeUid: auth.currentUser.uid`.
    // Formulário: src/app/dashboard-universidade/eventos/FormularioEvento.js
    function eventoFields() {
      return ['nome', 'descricao', 'data', 'local', 'publicoAlvo', 'preco',
              'tema', 'tipo', 'imagem', 'universidadeUid', 'universidadeId',
              'universidadeNome', 'criadoEm', 'atualizadoEm'];
    }

    function isValidEvento(data) {
      return data.keys().hasOnly(eventoFields())
        && data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 200
        && data.descricao is string && data.descricao.size() <= 5000
        && data.data is string && data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.local is string && data.local.size() <= 300
        && data.preco is number && data.preco >= 0
        && data.tema is string && data.tema.size() <= 100
        && data.tipo is string && data.tipo.size() <= 100
        && data.publicoAlvo is string && data.publicoAlvo.size() <= 100
        && (!('imagem' in data) || data.imagem == null
            || (data.imagem is string && data.imagem.size() <= 2048))
        && (!('universidadeId' in data) || data.universidadeId == null || data.universidadeId is string)
        && (!('universidadeNome' in data) || (data.universidadeNome is string && data.universidadeNome.size() <= 200));
    }

    // O vínculo com public/universidades.json tem de ser o mesmo da conta da
    // universidade (campo `universidadeId` em universidades/{uid}), para que
    // uma universidade não publique eventos em nome de outra.
    function matchesOwnUniversidadeId(data) {
      return data.get('universidadeId', null)
        == get(/databases/$(database)/documents/universidades/$(request.auth.uid)).data.get('universidadeId', null);
    }

    match /eventos/{eventoId} {
      allow read: if true; // Público para leitura

      // Ids só numéricos ("1", "2"...) são reservados aos eventos legados de
      // public/events.json, para que ninguém "sobrescreva" um evento legado
      // (e herde as avaliações dele). Migrações devem usar o Admin SDK.
      allow create: if isApprovedUniversity()
        && !eventoId.matches('^[0-9]+$')
        && request.resource.data.universidadeUid == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && matchesOwnUniversidadeId(request.resource.data)
        && isValidEvento(request.resource.data);

      // Dono (universidade aprovada) ou moderador. O dono do evento
      // (`universidadeUid`) e a data de criação nunca mudam.
      allow update: if isValidEvento(request.resource.data)
        && request.resource.data.universidadeUid == resource.data.universidadeUid
        && !changedKeys().hasAny(['criadoEm'])
        && (isModerator()
            || (isApprovedUniversity()
                && resource.data.universidadeUid == request.auth.uid
                && matchesOwnUniversidadeId(request.resource.data)));

      allow delete: if isModerator()
        || (isApprovedUniversity()
            && resource.data.universidadeUid == request.auth.uid);
    }

    // ------------------------------------------------------------------
    // Posts do fórum - leitura pública; escrita controlada
    // ------------------------------------------------------------------
    // Curtir: o usuário só pode adicionar/remover o PRÓPRIO uid em `curtidas`.
    function isValidLikeChange() {
      return request.resource.data.curtidas is list
        && request.resource.data.curtidas.toSet()
             .difference(resource.data.get('curtidas', []).toSet())
             .union(resource.data.get('curtidas', []).toSet()
                      .difference(request.resource.data.curtidas.toSet()))
             .hasOnly([request.auth.uid]);
    }

    // Comentar: só é permitido acrescentar UM comentário no final da lista,
    // com `autorUid` igual ao próprio uid, sem apagar os existentes.
    // `texto` tem até 280 caracteres; `respostaA` (opcional) é a chave do
    // comentário respondido (ver src/lib/forum.js).
    function isValidCommentAppend() {
      let antes = resource.data.get('comentarios', []);
      let depois = request.resource.data.comentarios;
      let novo = depois[depois.size() - 1];
      return depois is list
        && depois.size() == antes.size() + 1
        && depois.hasAll(antes)
        && novo.autorUid == request.auth.uid
        && novo.texto is string
        && novo.texto.size() <= 280
        && (novo.get('respostaA', null) == null
            || (novo.respostaA is string && novo.respostaA.size() <= 160));
    }

    // Tema do post (opcional): um dos TEMAS de src/lib/eventos.js, ou null
    function isValidTemaPost(data) {
      return data.get('tema', null) == null
        || (data.tema is string && data.tema.size() <= 60);
    }

    match /forumPosts/{postId} {
      allow read: if true; // Público para leitura

      allow create: if isSignedIn()
        && request.resource.data.autor.uid == request.auth.uid
        && (!('moderado' in request.resource.data) || request.resource.data.moderado == false)
        // Posts nascem sem curtidas/comentários (evita "curtidas" forjadas).
        && (!('curtidas' in request.resource.data) || request.resource.data.curtidas == [])
        && (!('comentarios' in request.resource.data) || request.resource.data.comentarios == [])
        && isValidTemaPost(request.resource.data);

      // Moderadores: qualquer campo (inclui moderado/moderadoPor/moderadoEm).
      // Autor: qualquer campo, exceto o autor, os campos de moderação e
      // curtidas/comentarios (que seguem as mesmas regras dos demais usuários,
      // para que ninguém forje curtidas ou comentários e ganhe pontos).
      // Demais usuários logados: apenas curtidas/comentarios.
      allow update: if isModerator()
        || (isOwner(resource.data.autor.uid)
            && !changedKeys().hasAny(['autor', 'moderado', 'moderadoPor', 'moderadoEm', 'curtidas', 'comentarios'])
            && isValidTemaPost(request.resource.data))
        || (isSignedIn()
            && changedKeys().hasOnly(['curtidas', 'comentarios'])
            && (!changedKeys().hasAny(['curtidas']) || isValidLikeChange())
            && (!changedKeys().hasAny(['comentarios']) || isValidCommentAppend()));

      allow delete: if isModerator() || isOwner(resource.data.autor.uid);
    }

    // ------------------------------------------------------------------
    // Denúncias (RF07) - qualquer usuário logado denuncia; só moderadores leem
    // ------------------------------------------------------------------
    // Id determinístico: `${tipo}_${alvoId}_${uid}`. Assim cada usuário só
    // consegue denunciar o mesmo conteúdo uma vez: um segundo setDoc no mesmo
    // id vira "update", que é negado a não moderadores (permission-denied).
    // Tipos:
    //  - 'post':       alvoId = id do forumPosts
    //  - 'comentario': alvoId = chave do comentário (`${autorUid}-${ms de criadoEm}`),
    //                  alvoPostId = id do forumPosts que contém o comentário
    //  - 'avaliacao':  alvoId = id da avaliacoes
    // Código cliente: src/lib/denuncias.js
    function denunciaFields() {
      return ['tipo', 'alvoId', 'alvoPostId', 'motivo', 'detalhe',
              'denuncianteUid', 'criadoEm', 'status'];
    }

    function isValidDenunciaAlvo(data) {
      return (data.tipo == 'post'
              && !('alvoPostId' in data)
              && exists(/databases/$(database)/documents/forumPosts/$(data.alvoId)))
        || (data.tipo == 'avaliacao'
              && !('alvoPostId' in data)
              && exists(/databases/$(database)/documents/avaliacoes/$(data.alvoId)))
        || (data.tipo == 'comentario'
              && data.alvoPostId is string
              && data.alvoPostId.matches('^[A-Za-z0-9_-]{1,128}$')
              && exists(/databases/$(database)/documents/forumPosts/$(data.alvoPostId)));
    }

    match /denuncias/{denunciaId} {
      allow read, update, delete: if isModerator();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(denunciaFields())
        && request.resource.data.keys().hasAll(['tipo', 'alvoId', 'motivo', 'denuncianteUid', 'criadoEm', 'status'])
        && request.resource.data.tipo in ['post', 'comentario', 'avaliacao']
        && request.resource.data.alvoId is string
        && request.resource.data.alvoId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.motivo in ['ofensivo', 'spam', 'discriminacao', 'informacao_falsa', 'outro']
        && (!('detalhe' in request.resource.data)
            || (request.resource.data.detalhe is string && request.resource.data.detalhe.size() <= 500))
        && request.resource.data.denuncianteUid == request.auth.uid
        && request.resource.data.status == 'aberta'
        && request.resource.data.criadoEm == request.time
        && denunciaId == request.resource.data.tipo + '_' + request.resource.data.alvoId + '_' + request.auth.uid
        && isValidDenunciaAlvo(request.resource.data);
    }
  }
}

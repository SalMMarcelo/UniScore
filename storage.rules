rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars de usuários: cada usuário escreve apenas no seu próprio path
    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024   // máx 5 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Imagens de avaliações: qualquer usuário autenticado pode fazer upload
    match /avaliacoes/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024  // máx 10 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Imagens de eventos: a conta de universidade envia no seu próprio path
    // (a permissão para cadastrar o evento é checada em firestore.rules)
    match /eventos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024   // máx 5 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Mídia do fórum: usuário autenticado, no seu próprio path.
    // Limites alinhados com LIMITES_MIDIA em src/lib/forum.js.
    match /forum/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && ((request.resource.contentType.matches('image/.*')
                        && request.resource.size <= 10 * 1024 * 1024)   // máx 10 MB
                       || (request.resource.contentType.matches('video/.*')
                        && request.resource.size <= 50 * 1024 * 1024)); // máx 50 MB
    }
  }
}
